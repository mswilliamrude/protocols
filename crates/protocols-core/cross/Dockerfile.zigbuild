# Alternative: Cross-compile using Zig as the C/C++ cross-compiler
# Zig bundles all cross-compilation toolchains - much cleaner than managing mingw-w64
#
# Build: docker build -f cross/Dockerfile.zigbuild -t pyprotocols-zig .
# Run:   docker run --rm -v $(pwd)/dist:/out pyprotocols-zig

FROM rust:1.88-bookworm

# Install Zig (cross-compilation toolchain)
RUN apt-get update && apt-get install -y \
    curl \
    xz-utils \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install Zig 0.13
RUN curl -L https://ziglang.org/download/0.13.0/zig-linux-x86_64-0.13.0.tar.xz | tar -xJ -C /opt \
    && ln -s /opt/zig-linux-x86_64-0.13.0/zig /usr/local/bin/zig

# Install maturin and cargo-zigbuild
RUN pip3 install --break-system-packages maturin>=1.5 \
    && cargo install cargo-zigbuild --locked

# Add all targets (x86_64 + ARM64 for Linux, Windows, macOS)
RUN rustup target add \
    x86_64-pc-windows-gnu \
    x86_64-unknown-linux-gnu \
    aarch64-unknown-linux-gnu \
    aarch64-pc-windows-gnullvm \
    x86_64-apple-darwin \
    aarch64-apple-darwin

WORKDIR /build

COPY . .

RUN cat > /build.sh <<'EOF'
#!/bin/bash
set -e

OUT_DIR="/out"
mkdir -p "$OUT_DIR"

cd /build

echo "==> Building protocols for Windows x86_64"
maturin build --release --target x86_64-pc-windows-gnu --out "$OUT_DIR" --zig

echo ""
echo "==> Building protocols for Windows ARM64"
maturin build --release --target aarch64-pc-windows-gnullvm --out "$OUT_DIR" --zig

echo ""
echo "==> Building protocols for Linux x86_64"
maturin build --release --target x86_64-unknown-linux-gnu --out "$OUT_DIR" --zig

echo ""
echo "==> Building protocols for Linux ARM64 (Raspberry Pi)"
maturin build --release --target aarch64-unknown-linux-gnu --out "$OUT_DIR" --zig

echo ""
echo "==> Building protocols for macOS x86_64 (Intel)"
maturin build --release --target x86_64-apple-darwin --out "$OUT_DIR" --zig

echo ""
echo "==> Building protocols for macOS ARM64 (Apple Silicon)"
maturin build --release --target aarch64-apple-darwin --out "$OUT_DIR" --zig

echo ""
echo "==> Build complete!"
ls -la "$OUT_DIR"/*.whl

echo ""
echo "==> Install with:"
echo "    pip install protocols-*.whl"
EOF

RUN chmod +x /build.sh

VOLUME /out

CMD ["/build.sh"]
